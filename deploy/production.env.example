# Copy to /opt/cukurpro/production.env on the VPS and set mode 0600.
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=cukurpro
POSTGRES_USER=cukurpro
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgres://cukurpro:replace-with-a-long-random-secret@postgres:5432/cukurpro

ALLOWED_ORIGINS=https://app.example.com
PUBLIC_API_BASE_URL=https://app.example.com
AUTH_RATE_LIMIT=10
PUBLIC_RATE_LIMIT=60
RATE_LIMIT_WINDOW_MS=60000
MAX_REQUEST_BODY_BYTES=262144

IMAGE_REGISTRY=ghcr.io/nicastra/barberkita
IMAGE_TAG=0000000000000000000000000000000000000000
